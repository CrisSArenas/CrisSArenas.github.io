{
  "name": "crissarenas-site",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "node scripts/gen-pages.mjs",
    "dev": "npm run gen && vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "npm run gen && tsc -p tsconfig.json --noEmit && vitest run && vite build && node scripts/publish.mjs"
  },
  "dependencies": {
    "d3": "^7.9.2",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
